{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://RepaleMayur.github.io/Portfolio",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:root": "tsc -b && vite build",
    "build:old": "cd old && npm run build",
    "build": "npm run build:root && npm run build:old && node -e \"require('fs-extra').copySync('old/dist', 'dist/old')\" && node -e \"require('fs-extra').copySync('dist/index.html', 'dist/404.html')\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "autoprefixer": "^10.5.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.38.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "fs-extra": "^11.3.0",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
